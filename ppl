-- DRAWINGS CLEANUP
-- ==========================================
local Drawings = {}
local function CleanupDrawings(plr)
    if Drawings[plr] then
        for _, draw in pairs(Drawings[plr]) do
            if type(draw) == "table" then
                for _, d in pairs(draw) do
                    if d and type(d.Remove) == "function" then
                        pcall(function() d:Remove() end)
                    end
                end
            else
                if draw and type(draw.Remove) == "function" then
                    pcall(function() draw:Remove() end)
                end
            end
        end
        Drawings[plr] = nil
    end
end

Players.PlayerRemoving:Connect(function(plr)
    CleanupDrawings(plr)
end)

