-- ==========================================
local function CreateDrawing(class, props)
    local obj = Drawing.new(class)
    for k, v in pairs(props) do obj[k] = v end
    obj.Visible = false
    return obj
end

local function UpdateESP()
    if isDestroyed then return end
    
    for plr, _ in pairs(Drawings) do
        if not plr or not plr.Parent or not plr:IsDescendantOf(Players) then
            CleanupDrawings(plr)
        end
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
            if Drawings[plr] then CleanupDrawings(plr) end
            continue
        end
        
        local char = plr.Character
        local hrp = char.HumanoidRootPart
        local head = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChild("Humanoid")
        
        if not Drawings[plr] then
            Drawings[plr] = {
                Box = CreateDrawing("Square", {Thickness = 1, Filled = false}),
                HealthBg = CreateDrawing("Square", {Thickness = 1, Filled = true, Color = Color3.fromRGB(50,50,50)}),
                HealthBar = CreateDrawing("Square", {Thickness = 1, Filled = true}),
                Name = CreateDrawing("Text", {Size = 14, Center = true, Outline = true}),
                HealthText = CreateDrawing("Text", {Size = 12, Center = true, Outline = true}),
                Tracker = CreateDrawing("Line", {Thickness = 1}),
                Bones = {}
            }
        end
        
        local d = Drawings[plr]
        
        local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
        local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local headPos = Camera:WorldToViewportPoint(head.Position)
        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.5, 0))
        
        local isVisible = onScreen and hrpPos.Z > 0 and headPos.Z > 0 and legPos.Z > 0 and distance < 500
        
        if isVisible then
            if hrpPos.X < 0 or hrpPos.Y < 0 or hrpPos.X > Camera.ViewportSize.X or hrpPos.Y > Camera.ViewportSize.Y then
                isVisible = false
            else
                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 2
                if height > 500 or width > 250 then isVisible = false end
            end
        end
        
        if isVisible and head and humanoid then
            local height = math.abs(headPos.Y - legPos.Y)
            local width = height / 2
            
            d.Box.Visible = Settings.ESP.Box
            d.Box.Color = Settings.AccentColor
            d.Box.Size = Vector2.new(width, height)
            d.Box.Position = Vector2.new(hrpPos.X - width/2, headPos.Y)
            
            d.HealthBg.Visible = Settings.ESP.Health
            d.HealthBar.Visible = Settings.ESP.Health
            d.HealthText.Visible = Settings.ESP.Health
            
            local hp = humanoid.Health / humanoid.MaxHealth
            local hHeight = height * hp
            
            d.HealthBg.Size = Vector2.new(3, height)
            d.HealthBg.Position = Vector2.new(d.Box.Position.X - 6, d.Box.Position.Y)
            d.HealthBar.Color = Color3.fromRGB(255 * (1-hp), 255 * hp, 0)
            d.HealthBar.Size = Vector2.new(3, hHeight)
            d.HealthBar.Position = Vector2.new(d.Box.Position.X - 6, d.Box.Position.Y + (height - hHeight))
            
            d.Name.Visible = Settings.ESP.Health
            d.Name.Text = plr.Name
            d.Name.Color = Settings.AccentColor
            d.Name.Position = Vector2.new(hrpPos.X, d.Box.Position.Y - 18)
            
            d.HealthText.Visible = Settings.ESP.Health
            d.HealthText.Text = math.floor(humanoid.Health) .. " HP"
            d.HealthText.Color = Color3.fromRGB(255, 255, 255)
            d.HealthText.Position = Vector2.new(hrpPos.X, d.Box.Position.Y + height + 12)
            
            d.Tracker.Visible = Settings.ESP.Tracker
            d.Tracker.Color = Settings.AccentColor
            d.Tracker.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            d.Tracker.To = Vector2.new(hrpPos.X, d.Box.Position.Y + height)
            
            for _, bone in pairs(d.Bones) do bone.Visible = false end
            if Settings.ESP.Bone then
                local function drawBone(p1, p2)
                    if not p1 or not p2 then return end
                    local v1, on1 = Camera:WorldToViewportPoint(p1.Position)
                    local v2, on2 = Camera:WorldToViewportPoint(p2.Position)
                    if on1 and on2 and v1.Z > 0 and v2.Z > 0 then
                        local line = d.Bones[p1.Name .. p2.Name] 
                        if not line then
                            line = CreateDrawing("Line", {Thickness = 1})
                            d.Bones[p1.Name .. p2.Name] = line
                        end
                        line.Visible = true
                        line.From = Vector2.new(v1.X, v1.Y)
                        line.To = Vector2.new(v2.X, v2.Y)
                        line.Color = Settings.AccentColor
                    end
                end
                if char:FindFirstChild("UpperTorso") then
                    drawBone(char.Head, char.UpperTorso); drawBone(char.UpperTorso, char.LowerTorso)
                    drawBone(char.LowerTorso, char.LeftUpperLeg); drawBone(char.LeftUpperLeg, char.LeftLowerLeg)
                    drawBone(char.LowerTorso, char.RightUpperLeg); drawBone(char.RightUpperLeg, char.RightLowerLeg)
                    drawBone(char.UpperTorso, char.LeftUpperArm); drawBone(char.LeftUpperArm, char.LeftLowerArm)
                    drawBone(char.UpperTorso, char.RightUpperArm); drawBone(char.RightUpperArm, char.RightLowerArm)
                elseif char:FindFirstChild("Torso") then
                    drawBone(char.Head, char.Torso); drawBone(char.Torso, char["Left Leg"]); drawBone(char.Torso, char["Right Leg"])
                    drawBone(char.Torso, char["Left Arm"]); drawBone(char.Torso, char["Right Arm"])
                end
            end
        else
            d.Box.Visible = false
            d.HealthBg.Visible = false
            d.HealthBar.Visible = false
            d.Name.Visible = false
            d.HealthText.Visible = false
            d.Tracker.Visible = false
            for _, bone in pairs(d.Bones) do bone.Visible = false end
        end
    end
end

