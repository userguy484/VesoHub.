    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 20
    btn.BorderSizePixel = 0
    btn.Active = true
    btn.Parent = miniGui
    createCorner(btn, 12)
    registerAccent(btn, "TextColor3")

    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.Accent
    stroke.Thickness = 1.5
    stroke.Transparency = 0.3
    stroke.Parent = btn
    registerAccent(stroke, "Color")

    btn.MouseButton1Click:Connect(safe(function()
        playClickSound()
        isMinimized = false
        isMinimizedGlobal = false
        mainFrame.Visible = true
        -- restore cat ears if enabled
        if Theme.CatEars then
            catEarsGui.Enabled = true
            updateEarsPos()
        end
        if miniGui then miniGui:Destroy() miniGui = nil end
    end, "mini restore"))
end

local function minimize()
    isMinimized = true
    isMinimizedGlobal = true
    mainFrame.Visible = false
    -- hide cat ears
    catEarsGui.Enabled = false
    createMiniButton()
end

minBtn.MouseButton1Click:Connect(safe(function()
    playClickSound()
    minimize()
end, "min btn"))

UserInputService.InputBegan:Connect(function(input, gpe)
    if input.KeyCode == Enum.KeyCode.RightShift then
        playClickSound()
        if isMinimized then
            isMinimized = false
            isMinimizedGlobal = false
            mainFrame.Visible = true
            -- restore cat ears if enabled
            if Theme.CatEars then
                catEarsGui.Enabled = true
                updateEarsPos()
            end
            if miniGui then miniGui:Destroy() miniGui = nil end
        else
            minimize()
        end
        return
    end
    if input.KeyCode == Enum.KeyCode.RightControl then
        playClickSound()
        if not dexBuilt then
            task.spawn(safe(function() refreshDex() end, "dex refresh"))
            dexBuilt = true
        end
        dexScreen.Enabled = not dexScreen.Enabled
    end
end)

