local AccentElements = {}
local function registerAccent(obj, property)
    table.insert(AccentElements, {obj = obj, prop = property or "BackgroundColor3"})
end

local function updateAccent()
    for _, entry in ipairs(AccentElements) do
        local obj = entry.obj
        if obj and obj.Parent then
            if entry.prop == "TextColor3" then obj.TextColor3 = Theme.Accent
            elseif entry.prop == "BackgroundColor3" then obj.BackgroundColor3 = Theme.Accent
            elseif entry.prop == "Color" then obj.Color = Theme.Accent
            elseif entry.prop == "Color3" then obj.Color3 = Theme.Accent
            elseif entry.prop == "ImageColor3" then obj.ImageColor3 = Theme.Accent
            elseif entry.prop == "ScrollBarImageColor3" then obj.ScrollBarImageColor3 = Theme.Accent
            end
        end
    end
end

