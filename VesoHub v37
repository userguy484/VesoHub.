local function stopAnimation()
    VesoHub.Animation.Active = false
    if VesoHub.Animation.Connection then VesoHub.Animation.Connection:Disconnect() VesoHub.Animation.Connection = nil end
    if VesoHub.Animation.MoveConnection then VesoHub.Animation.MoveConnection:Disconnect() VesoHub.Animation.MoveConnection = nil end
    for part, cf in pairs(VesoHub.Animation.OriginalCFrames) do
        if part and part.Parent then part.CFrame = cf part.Anchored = false end
    end
    for _, emitter in pairs(VesoHub.Animation.EffectsInstances) do if emitter then emitter:Destroy() end end
    VesoHub.Animation.EffectsInstances = {}
end

local function startAnimation()
    if VesoHub.Animation.Active then return end
    if #VesoHub.Animation.Parts == 0 then return end
    VesoHub.Animation.Active = true
    VesoHub.Animation.Time = 0
    VesoHub.Animation.Connection = RunService.Heartbeat:Connect(function(dt)
        if not VesoHub.Animation.Active then return end
        VesoHub.Animation.Time = VesoHub.Animation.Time + dt * (VesoHub.Animation.Speed or 1)
        local t = VesoHub.Animation.Time
        local origin = VesoHub.Animation.Origin
        local mode = VesoHub.Animation.Mode
        local total = #VesoHub.Animation.Parts
        for i, part in pairs(VesoHub.Animation.Parts) do
            if not part or not part.Parent then continue end
            if mode == "Spin" then
                local angle = t * 2 + i * 0.3
                part.CFrame = CFrame.new(origin + Vector3.new(0, 3, 0)) * CFrame.Angles(angle, angle * 0.7, angle * 0.5) * CFrame.new(0, i * 0.5, 0)
            elseif mode == "Float" then
                local yOffset = math.sin(t * 2 + i) * 1
                part.CFrame = CFrame.new(origin + Vector3.new((i - total/2) * 0.4, 3 + yOffset, 0))
            elseif mode == "Scatter" then
                local angle = (i / total) * math.pi * 2 + t
                local radius = 3 + math.sin(t + i) * 2
                part.CFrame = CFrame.new(origin + Vector3.new(math.cos(angle) * radius, 3 + math.sin(t * 2 + i), math.sin(angle) * radius))
            elseif mode == "Explode" then
                local angle = (i / total) * math.pi * 2
                local dist = t * 5
                part.CFrame = CFrame.new(origin + Vector3.new(math.cos(angle) * dist, dist * 0.5 + 3, math.sin(angle) * dist)) * CFrame.Angles(t * 3, t * 2, t)
            elseif mode == "Wave" then
                local xOffset = math.sin(t * 2 + i * 0.5) * 2
                local yOffset = math.cos(t * 2 + i * 0.5) * 2
                part.CFrame = CFrame.new(origin + Vector3.new((i - total/2) * 0.5 + xOffset, 3 + yOffset, 0))
            elseif mode == "Orbit" then
                local angle = t + i * 0.5
                local radius = 5 + (i % 5)
                part.CFrame = CFrame.new(origin + Vector3.new(math.cos(angle) * radius, 3 + (i % 5), math.sin(angle) * radius)) * CFrame.Angles(angle, angle, angle)
            elseif mode == "Tornado" then
                local angle = t * 3 + i
                local radius = (i % 10) * 1 + 2
                local height = (t * 5 + i * 0.5) % 12
                part.CFrame = CFrame.new(origin + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)) * CFrame.Angles(angle, angle, angle)
            elseif mode == "Black Hole" then
                local angle = (i / total) * math.pi * 2
                local dist = math.max(0.5, 5 - t * 2)
                part.CFrame = CFrame.new(origin + Vector3.new(math.cos(angle) * dist, 3 + math.sin(angle) * dist * 0.3, math.sin(angle) * dist)) * CFrame.Angles(t * 5, t * 5, t * 5)
            elseif mode == "Ragdoll" then
                if part.Anchored then part.Anchored = false end
            elseif mode == "Pulse" then
                local angle = (i / total) * math.pi * 2
                local radius = 3 + math.sin(t * 4 + i) * 2
                part.CFrame = CFrame.new(origin + Vector3.new(math.cos(angle) * radius, 3 + math.cos(t * 4 + i) * 1, math.sin(angle) * radius))
            end
        end
    end)
    VesoHub.Animation.MoveConnection = RunService.Heartbeat:Connect(function(dt)
        if not VesoHub.Animation.Active then return end
        local cam = workspace.CurrentCamera
        local move = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
        if move.Magnitude > 0 then
            move = move.Unit * (VesoHub.Loop.MoveSpeed or 30) * dt
            VesoHub.Animation.Origin = VesoHub.Animation.Origin + move
        end
    end)
end

local function killAndAnimate(savePos)
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and savePos then VesoHub.Loop.SavedPosition = hrp.Position end
    stopAnimation()
    humanoid.Health = 0
    task.wait(0.15)
    VesoHub.Animation.Parts = {}
    VesoHub.Animation.OriginalCFrames = {}
    VesoHub.Animation.EffectsInstances = {}
    VesoHub.Animation.Origin = VesoHub.Loop.SavedPosition or Vector3.new(0, 0, 0)
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Anchored = true
            table.insert(VesoHub.Animation.Parts, part)
            VesoHub.Animation.OriginalCFrames[part] = part.CFrame
        end
    end
    startAnimation()
end

