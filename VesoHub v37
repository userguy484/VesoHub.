local function buildExplorerRow(parent, instance, depth)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 18)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local expand = Instance.new("TextButton")
    expand.Size = UDim2.new(0, 14, 0, 14)
    expand.Position = UDim2.new(0, depth * 14 + 2, 0, 2)
    expand.BackgroundTransparency = 1
    expand.Text = "+"
    expand.TextColor3 = Color3.fromRGB(180, 180, 180)
    expand.Font = Enum.Font.SourceSansBold
    expand.TextSize = 14
    expand.BorderSizePixel = 0
    expand.Parent = row

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 14, 0, 14)
    icon.Position = UDim2.new(0, depth * 14 + 18, 0, 2)
    icon.BackgroundTransparency = 1
    icon.Text = "◆"
    icon.TextColor3 = Color3.fromRGB(120, 180, 255)
    icon.Font = Enum.Font.SourceSans
    icon.TextSize = 11
    icon.Parent = row

    local nameBtn = Instance.new("TextButton")
    nameBtn.Size = UDim2.new(1, -(depth * 14 + 36), 1, 0)
    nameBtn.Position = UDim2.new(0, depth * 14 + 34, 0, 0)
    nameBtn.BackgroundTransparency = 1
    nameBtn.Text = instance.Name .. "  (" .. instance.ClassName .. ")"
    nameBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    nameBtn.Font = Enum.Font.SourceSans
    nameBtn.TextSize = 13
    nameBtn.TextXAlignment = Enum.TextXAlignment.Left
    nameBtn.BorderSizePixel = 0
    nameBtn.Parent = row

    local children = instance:GetChildren()
    if #children == 0 then expand.Text = "" end

    local built = false
    local childContainer = nil
    expand.MouseButton1Click:Connect(safe(function()
        if not built then
            childContainer = Instance.new("Frame")
            childContainer.Size = UDim2.new(1, 0, 0, 0)
            childContainer.AutomaticSize = Enum.AutomaticSize.Y
            childContainer.BackgroundTransparency = 1
            childContainer.Visible = true
            childContainer.Parent = row
            local cl = Instance.new("UIListLayout")
            cl.Padding = UDim.new(0, 1)
            cl.Parent = childContainer
            for _, c in pairs(children) do
                buildExplorerRow(childContainer, c, depth + 1)
            end
            built = true
            expand.Text = "-"
        else
            childContainer.Visible = not childContainer.Visible
            expand.Text = childContainer.Visible and "-" or "+"
        end
    end, "expand explorer"))
end

local function refreshDex()
    for _, c in pairs(dexScroll:GetChildren()) do
        if not c:IsA("UIListLayout") then c:Destroy() end
    end
    buildExplorerRow(dexScroll, game, 0)
end

