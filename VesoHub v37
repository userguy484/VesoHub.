local function removeESP(player)
    if VesoHub.ESPObjects[player] then
        local d = VesoHub.ESPObjects[player]
        if d.NameGui then d.NameGui:Destroy() end
        if d.BoxGui then d.BoxGui:Destroy() end
        if d.HealthGui then d.HealthGui:Destroy() end
        if d.Tracer and d.Tracer.line then d.Tracer.line:Destroy() end
        for _, b in pairs(d.Bones or {}) do if b.line then b.line:Destroy() end end
        VesoHub.ESPObjects[player] = nil
    end
end

local function hideAll(d)
    if d.NameGui then d.NameGui.Enabled = false end
    if d.BoxGui then d.BoxGui.Enabled = false end
    if d.HealthGui then d.HealthGui.Enabled = false end
    if d.Tracer and d.Tracer.line then d.Tracer.line.Visible = false end
    for _, b in pairs(d.Bones or {}) do if b.line then b.line.Visible = false end end
end

local function showAll(d)
    if d.NameGui then d.NameGui.Enabled = true end
    if d.BoxGui then d.BoxGui.Enabled = true end
    if d.HealthGui then d.HealthGui.Enabled = true end
    if d.Tracer and d.Tracer.line then d.Tracer.line.Visible = true end
    for _, b in pairs(d.Bones or {}) do if b.line then b.line.Visible = true end end
end

local espLoop = RunService.RenderStepped:Connect(function()
    local ok, err = pcall(function()
        tracerOrigin.CFrame = Camera.CFrame * CFrame.new(0, -1.5, -2)
        if not VesoHub.Settings.ESP then
            for _, d in pairs(VesoHub.ESPObjects) do hideAll(d) end
            return
        end
        for player, d in pairs(VesoHub.ESPObjects) do
            local char = player.Character
            if not char then hideAll(d) continue end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not humanoid or not hrp then hideAll(d) continue end
            if VesoHub.Settings.TeamCheck and player.Team == LocalPlayer.Team then hideAll(d) continue end
            showAll(d)
            if d.NameGui then d.NameGui.Enabled = VesoHub.Settings.ESPName end
            if d.BoxGui then d.BoxGui.Enabled = VesoHub.Settings.ESPBox end
            if d.HealthGui then d.HealthGui.Enabled = VesoHub.Settings.ESPHealth end
            if d.Tracer and d.Tracer.line then d.Tracer.line.Visible = VesoHub.Settings.ESPTracers end
            for _, b in pairs(d.Bones or {}) do
                if b.line then b.line.Visible = VesoHub.Settings.ESPBone end
            end
            if d.BoxGui then
                local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
                local scale = math.clamp(1000 / distance, 20, 200)
                d.BoxGui.Size = UDim2.new(0, scale * 0.5, 0, scale * 1.4)
            end
            if d.HealthBar then
                local hp = humanoid.Health / math.max(humanoid.MaxHealth, 1)
                d.HealthBar.Size = UDim2.new(hp, 0, 1, 0)
                d.HealthBar.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1 - hp)), math.floor(255 * hp), 0)
            end
            if d.NameGui then
                local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
                local scale = math.clamp(1000 / distance, 20, 200)
                d.NameGui.StudsOffsetWorldSpace = Vector3.new(0, 1 + scale * 0.009, 0)
            end
            if VesoHub.Settings.ESPBone then
                for _, b in pairs(d.Bones or {}) do updateLine(b) end
            end
            if VesoHub.Settings.ESPTracers and d.Tracer then updateLine(d.Tracer) end
        end
    end)
    if not ok then warn("[VesoHub ESP] " .. tostring(err)) end
end)
table.insert(VesoHub.Connections, espLoop)

