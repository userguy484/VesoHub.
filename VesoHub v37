local function createMiniButton()
    if miniGui then miniGui:Destroy() end
    miniGui = Instance.new("ScreenGui")
    miniGui.Name = "VesoMini"
    miniGui.ResetOnSpawn = false
    miniGui.IgnoreGuiInset = true
    miniGui.DisplayOrder = 101
