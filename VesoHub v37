local oldPrint = print
local oldWarn = warn

local function customPrint(...)
    oldPrint(...)
    local parts = {}
    for i = 1, select("#", ...) do
        table.insert(parts, tostring(select(i, ...)))
    end
    addOutput(table.concat(parts, " "), "info")
end

local function customWarn(...)
    oldWarn(...)
    local parts = {}
    for i = 1, select("#", ...) do
        table.insert(parts, tostring(select(i, ...)))
    end
    addOutput(table.concat(parts, " "), "warn")
end

local function runWithOutput(code)
    local env = getfenv and getfenv() or _G
    local oldEnvPrint = env.print
    local oldEnvWarn = env.warn
    local oldEnvLoadstring = env.loadstring
    env.print = customPrint
    env.warn = customWarn
    env.loadstring = function(src, chunkname)
        local fn, err = oldEnvLoadstring and oldEnvLoadstring(src, chunkname) or loadstring(src, chunkname)
        if fn and setfenv then setfenv(fn, env) end
        return fn, err
    end
    local ok, err = pcall(function()
        local fn, lerr = env.loadstring(code)
        if not fn then error(lerr, 0) end
        fn()
    end)
    env.print = oldEnvPrint
    env.warn = oldEnvWarn
    env.loadstring = oldEnvLoadstring
    return ok, err
end

