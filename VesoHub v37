local function safe(fn, label)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then
            warn("[VesoHub] " .. tostring(label) .. ": " .. tostring(err))
            task.spawn(showErrorBadge, tostring(err))
        end
    end
end

local activeSounds = {}

local function playSoundId(id)
    if not id or id == "" then return end
    id = tostring(id):gsub("%D", "")
    if id == "" then return end
    local assetUrl = "rbxassetid://" .. id
    for _, s in pairs(activeSounds) do
        pcall(function() s:Stop() s:Destroy() end)
    end
    activeSounds = {}
    local s = Instance.new("Sound")
    s.Name = "VesoPlaySound"
    s.SoundId = assetUrl
    s.Volume = 2
    s.PlayOnRemove = false
    s.Looped = false
    s.Parent = SoundService
    table.insert(activeSounds, s)
    task.spawn(function()
        pcall(function() ContentProvider:PreloadAsync({s}) end)
        task.wait(0.08)
        pcall(function() s:Play() end)
    end)
    s.Ended:Connect(function()
        if s then s:Destroy() end
    end)
    task.delay(60, function()
        if s and s.Parent then s:Destroy() end
    end)
end

local function playClickSound()
    playSoundId(Theme.SoundId)
end

local function playOpenSound()
    playSoundId(Theme.SoundId)
end

