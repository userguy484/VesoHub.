-- badge state machine
local badgeStates = {
    loading = { text = "loading", color = Color3.fromRGB(220, 180, 90), bg = Color3.fromRGB(40, 34, 24), border = Color3.fromRGB(120, 95, 45) },
    loaded  = { text = "loaded",  color = Color3.fromRGB(110, 200, 130), bg = Color3.fromRGB(24, 40, 30), border = Color3.fromRGB(60, 120, 80) },
    error   = { text = "error",   color = Color3.fromRGB(230, 100, 100), bg = Color3.fromRGB(40, 24, 24), border = Color3.fromRGB(120, 55, 55) },
    warn    = { text = "warn",    color = Color3.fromRGB(220, 180, 90), bg = Color3.fromRGB(40, 34, 24), border = Color3.fromRGB(120, 95, 45) },
}

local currentBadgeState = "loading"

local function setBadge(stateName, overrideText)
    local s = badgeStates[stateName]
    if not s then return end
    currentBadgeState = stateName
    BadgeLabel.Text = overrideText or s.text
    BadgeLabel.TextColor3 = s.color
    BadgeDot.BackgroundColor3 = s.color
    TweenService:Create(Badge, TweenInfo.new(0.2), { BackgroundColor3 = s.bg }):Play()
    TweenService:Create(BadgeStroke, TweenInfo.new(0.2), { Color = s.border }):Play()
    -- auto-size to text
    local padding = 28
    Badge.Size = UDim2.new(0, math.max(60, (overrideText or s.text):len() * 7 + padding), 0, 16)
end

-- initial
setBadge("loading")

-- error hook — if any Lua error occurs inside the explorer, flip badge
local originalError = getfenv and nil
local function reportError(err)
    setBadge("error", "error")
    warn("[sebb explorer] " .. tostring(err))
end

