local function classIcon(inst)
    local cls = inst.ClassName
    if inst == game then return "G" end
    if cls == "Folder" then return "F" end
    if cls == "Script" then return "S" end
    if cls == "LocalScript" then return "L" end
    if cls == "ModuleScript" then return "M" end
    if cls:match("Script") then return "S" end
    if cls:match("Value") then return "V" end
    if cls:match("Part$") or cls:match("Mesh") or cls == "Model" then return "P" end
    if cls == "Player" or cls == "Players" then return "U" end
    if cls:match("Gui") or cls:match("Frame") or cls:match("Label") or cls:match("Button") then return "I" end
    return "·"
end

local function isScript(inst)
    return inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript")
end

local function getSource(inst)
    local ok, src = pcall(function() return inst.Source end)
    if ok and type(src) == "string" and #src > 0 then
        return src, "source"
    end
    if decompile then
        local ok2, dec = pcall(decompile, inst)
        if ok2 and type(dec) == "string" and #dec > 0 then
            return dec, "decompile"
        end
    end
    if getscriptbytecode then
        local ok3, bc = pcall(getscriptbytecode, inst)
        if ok3 and bc then
            return "-- raw bytecode (" .. tostring(#bc) .. " bytes)\n" .. string.sub(tostring(bc), 1, 8000), "bytecode"
        end
    end
    return nil, "unavailable"
end

local function openSource(inst)
    if not inst then return end
    currentSourceScript = inst
    sourceEditing = false
    SourceBox.Active = false
    SourceEdit.TextColor3 = Color3.fromRGB(150, 150, 158)
    SourceEdit.Text = "edit"
    SourceNameLabel.Text = inst.Name .. "  ·  " .. inst.ClassName

    local ok, src, mode = pcall(getSource, inst)
    if not ok then
        setSrcBadge("error", "error")
        SourceBox.Text = "-- error while reading source\n-- " .. tostring(src) .. "\n"
    elseif src then
        SourceBox.Text = src
        setSrcBadge("loaded", mode)
    else
        setSrcBadge("warn", "no-source")
        SourceBox.Text = "-- source unavailable\n-- this executor may block Source or decompile for this script\n-- (server-side scripts are typically inaccessible)\n"
    end

    SourceOverlay.Visible = true
end

