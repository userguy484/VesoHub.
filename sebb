local function clearTree()
    for _, child in ipairs(TreeScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
    end
    rows = {}
    nodeByInstance = {}
end

local function rebuildTree()
    clearTree()
    local function addNode(inst, depth)
        local node = { instance = inst, depth = depth, expanded = expanded[inst] == true }
        nodeByInstance[inst] = node

        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 20)
        row.BackgroundColor3 = Color3.fromRGB(23, 23, 27)
        row.BackgroundTransparency = (inst == selectedInstance) and 0 or 1
        row.BorderSizePixel = 0
        row.ZIndex = 12
        row.Parent = TreeScroll

        local rowC = Instance.new("UICorner")
        rowC.CornerRadius = UDim.new(0, 3)
        rowC.Parent = row

        local kids = inst:GetChildren()
        local arrowBtn = Instance.new("TextButton")
        arrowBtn.Size = UDim2.new(0, 14, 0, 20)
        arrowBtn.Position = UDim2.new(0, depth * 12 + 4, 0, 0)
        arrowBtn.BackgroundTransparency = 1
        arrowBtn.Text = (#kids > 0) and (node.expanded and "▾" or "▸") or ""
        arrowBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
        arrowBtn.Font = Enum.Font.GothamBold
        arrowBtn.TextSize = 10
        arrowBtn.ZIndex = 13
        arrowBtn.Parent = row

        local icon = Instance.new("TextLabel")
        icon.Size = UDim2.new(0, 16, 1, 0)
        icon.Position = UDim2.new(0, depth * 12 + 20, 0, 0)
        icon.BackgroundTransparency = 1
        icon.Text = classIcon(inst)
        icon.TextColor3 = Color3.fromRGB(110, 170, 230)
        icon.Font = Enum.Font.Code
        icon.TextSize = 11
        icon.ZIndex = 13
        icon.Parent = row

        local name = Instance.new("TextButton")
        name.Size = UDim2.new(1, -(depth * 12 + 40), 1, 0)
        name.Position = UDim2.new(0, depth * 12 + 36, 0, 0)
        name.BackgroundTransparency = 1
        name.Text = inst.Name
        name.TextColor3 = (inst == selectedInstance) and Color3.fromRGB(230, 230, 240) or Color3.fromRGB(200, 200, 210)
        name.Font = Enum.Font.Gotham
        name.TextSize = 12
        name.TextXAlignment = Enum.TextXAlignment.Left
        name.TextTruncate = Enum.TextTruncate.AtEnd
        name.ZIndex = 13
        name.Parent = row

        row.MouseEnter:Connect(function()
            if inst ~= selectedInstance then row.BackgroundTransparency = 0.7 end
        end)
        row.MouseLeave:Connect(function()
            if inst ~= selectedInstance then row.BackgroundTransparency = 1 end
        end)

        node.refresh = function()
            row.BackgroundColor3 = Color3.fromRGB(23, 23, 27)
            row.BackgroundTransparency = (inst == selectedInstance) and 0 or 1
            name.TextColor3 = (inst == selectedInstance) and Color3.fromRGB(230, 230, 240) or Color3.fromRGB(200, 200, 210)
        end

        local function select()
            if selectedInstance and nodeByInstance[selectedInstance] then
                nodeByInstance[selectedInstance].refresh()
            end
            selectedInstance = inst
            node.refresh()
            showProperties(inst)
            SourceOverlay.Visible = false
        end

        name.MouseButton1Click:Connect(select)
        arrowBtn.MouseButton1Click:Connect(function()
            if #kids > 0 then
                expanded[inst] = not expanded[inst]
                rebuildTree()
            end
        end)

        table.insert(rows, node)
        if node.expanded then
            for _, child in ipairs(kids) do addNode(child, depth + 1) end
        end
    end
    addNode(rootInstance, 0)
end

