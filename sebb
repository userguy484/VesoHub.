for i = 1, 3 do
    local dot = Instance.new("Frame")
    if i == 1 then dot.Position = UDim2.new(0, 8, 0, 8)
    elseif i == 2 then dot.Position = UDim2.new(0, 4, 0, 8)
    else dot.Position = UDim2.new(0, 8, 0, 4) end
