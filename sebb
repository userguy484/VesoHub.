local function getProps(inst)
    local props = {}
    local ok = pcall(function()
        for _, p in ipairs(inst:GetProperties()) do table.insert(props, p) end
    end)
    if not ok or #props == 0 then
        local ok2, list = pcall(function() return getproperties(inst) end)
        if ok2 and type(list) == "table" then
            for _, p in ipairs(list) do table.insert(props, p) end
        end
    end
    return props
end

local function clearProps()
    for _, child in ipairs(PropScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
    end
end

local function makePropRow(prop, inst, order)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 24)
    row.BackgroundColor3 = Color3.fromRGB(26, 26, 31)
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.ZIndex = 12
    row.Parent = PropScroll

    local rc = Instance.new("UICorner")
    rc.CornerRadius = UDim.new(0, 3)
    rc.Parent = row

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(0, 180, 1, 0)
    nameLbl.Position = UDim2.new(0, 8, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = prop
    nameLbl.TextColor3 = Color3.fromRGB(190, 190, 200)
    nameLbl.Font = Enum.Font.Gotham
    nameLbl.TextSize = 11
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
    nameLbl.ZIndex = 13
    nameLbl.Parent = row

    local ok, val = pcall(function() return inst[prop] end)
    if not ok then return row end

    local valType = typeof(val)

    if valType == "boolean" then
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 50, 0, 18)
        btn.Position = UDim2.new(1, -58, 0.5, -9)
        btn.BackgroundColor3 = val and Color3.fromRGB(70, 125, 90) or Color3.fromRGB(45, 45, 54)
        btn.Text = tostring(val)
        btn.TextColor3 = Color3.fromRGB(230, 230, 240)
        btn.Font = Enum.Font.Code
        btn.TextSize = 10
        btn.AutoButtonColor = false
        btn.ZIndex = 13
        btn.Parent = row
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 3); bc.Parent = btn
        btn.MouseButton1Click:Connect(function()
            local ok2, cur = pcall(function() return inst[prop] end)
            if not ok2 then return end
            local newVal = not cur
            local ok3 = pcall(function() inst[prop] = newVal end)
            if ok3 then
                btn.Text = tostring(newVal)
                btn.BackgroundColor3 = newVal and Color3.fromRGB(70, 125, 90) or Color3.fromRGB(45, 45, 54)
            end
        end)
    elseif valType == "number" or valType == "string" then
        local tb = Instance.new("TextBox")
        tb.Size = UDim2.new(0, 200, 1, -4)
        tb.Position = UDim2.new(1, -208, 0, 2)
        tb.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
        tb.Text = tostring(val)
        tb.TextColor3 = Color3.fromRGB(220, 220, 230)
        tb.Font = Enum.Font.Code
        tb.TextSize = 11
        tb.TextXAlignment = Enum.TextXAlignment.Left
        tb.ClearTextOnFocus = false
        tb.ZIndex = 13
        tb.Parent = row
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 3); bc.Parent = tb
        local bs = Instance.new("UIStroke"); bs.Color = Color3.fromRGB(45, 45, 54); bs.Parent = tb
        tb.FocusLost:Connect(function()
            local ok3 = pcall(function()
                if valType == "number" then
                    local n = tonumber(tb.Text)
                    if n then inst[prop] = n end
                else
                    inst[prop] = tb.Text
                end
            end)
            if not ok3 then
                local ok4, cur = pcall(function() return inst[prop] end)
                tb.Text = ok4 and tostring(cur) or tostring(val)
            end
        end)
    else
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 200, 1, 0)
        lbl.Position = UDim2.new(1, -208, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = tostring(val)
        lbl.TextColor3 = Color3.fromRGB(140, 140, 150)
        lbl.Font = Enum.Font.Code
        lbl.TextSize = 10
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextTruncate = Enum.TextTruncate.AtEnd
        lbl.ZIndex = 13
        lbl.Parent = row
    end

    return row
end

function showProperties(inst)
    clearProps()
    PropTitle.Text = inst.Name .. "  ·  " .. inst.ClassName
    SourceBtn.Visible = isScript(inst)

    local ok, props = pcall(getProps, inst)
    if not ok or not props then
        setBadge("warn", "warn")
        return
    end
    table.sort(props)
    local order = 0
    for _, p in ipairs(props) do
        order += 1
        pcall(makePropRow, p, inst, order)
    end
end

-- ////////////////////////////////////////////////////////////////////////////
-- search
-- ////////////////////////////////////////////////////////////////////////////
local searchDebounce = 0
local lastSearch = ""

local function runSearch(text)
    clearTree()
    if text == "" then rebuildTree(); return end

    local lower = string.lower(text)
    local count = 0
    local limit = 300

    local function addResult(inst)
        if count >= limit then return end
        count += 1

        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 20)
        row.BackgroundColor3 = Color3.fromRGB(23, 23, 27)
        row.BackgroundTransparency = (inst == selectedInstance) and 0 or 1
        row.BorderSizePixel = 0
        row.ZIndex = 12
        row.Parent = TreeScroll

        local rowC = Instance.new("UICorner"); rowC.CornerRadius = UDim.new(0, 3); rowC.Parent = row

        local pathParts = {}
        local cur = inst
        while cur and cur ~= game do
            table.insert(pathParts, 1, cur.Name)
            cur = cur.Parent
        end
        local pathStr = "game." .. table.concat(pathParts, ".")

        local icon = Instance.new("TextLabel")
        icon.Size = UDim2.new(0, 16, 1, 0)
        icon.Position = UDim2.new(0, 4, 0, 0)
        icon.BackgroundTransparency = 1
        icon.Text = classIcon(inst)
        icon.TextColor3 = Color3.fromRGB(110, 170, 230)
        icon.Font = Enum.Font.Code
        icon.TextSize = 11
        icon.ZIndex = 13
        icon.Parent = row

        local nameBtn = Instance.new("TextButton")
        nameBtn.Size = UDim2.new(1, -24, 1, 0)
        nameBtn.Position = UDim2.new(0, 22, 0, 0)
        nameBtn.BackgroundTransparency = 1
        nameBtn.Text = inst.Name .. "   ·   " .. pathStr
        nameBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
        nameBtn.Font = Enum.Font.Gotham
        nameBtn.TextSize = 11
        nameBtn.TextXAlignment = Enum.TextXAlignment.Left
        nameBtn.TextTruncate = Enum.TextTruncate.AtEnd
        nameBtn.ZIndex = 13
        nameBtn.Parent = row

        nameBtn.MouseButton1Click:Connect(function()
            selectedInstance = inst
            showProperties(inst)
            SourceOverlay.Visible = false
            for _, c in ipairs(TreeScroll:GetChildren()) do
                if c:IsA("Frame") then c.BackgroundTransparency = 1 end
            end
            row.BackgroundTransparency = 0
        end)

        row.MouseEnter:Connect(function() row.BackgroundTransparency = 0.7 end)
        row.MouseLeave:Connect(function()
            if inst ~= selectedInstance then row.BackgroundTransparency = 1 end
        end)
    end

    local ok, err = pcall(function()
        for _, d in ipairs(game:GetDescendants()) do
            if string.find(string.lower(d.Name), lower, 1, true) or
               string.find(string.lower(d.ClassName), lower, 1, true) then
                addResult(d)
                if count >= limit then break end
            end
        end
    end)
    if not ok then
        setBadge("error", "search-err")
    end

    if count == 0 then
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 40)
        lbl.BackgroundTransparency = 1
        lbl.Text = "no matches"
        lbl.TextColor3 = Color3.fromRGB(120, 120, 130)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12
        lbl.ZIndex = 13
        lbl.Parent = TreeScroll
    end
end

Search:GetPropertyChangedSignal("Text"):Connect(function()
    local text = Search.Text
    if text == lastSearch then return end
    lastSearch = text
    searchDebounce += 1
    local my = searchDebounce
    task.delay(0.3, function()
        if my == searchDebounce then runSearch(text) end
    end)
end)

